          "query": "import \"date\"\r\nimport \"strings\"\r\n\r\n// Grafana の変数が置き換わらなかったとき($ で始まる/空)は既定値 d を使う\r\npick = (s, d) => if strings.hasPrefix(v: s, prefix: \"$\") or s == \"\" then d else s\r\n\r\nmode      = pick(s: \"$range_mode\", d: \"dashboard\")\r\nrel       = duration(v: pick(s: \"$relative\", d: \"-15m\"))\r\nabs_start = time(v: pick(s: \"$abs_start\", d: \"2026-09-28T20:30:00+09:00\"))\r\nabs_stop  = time(v: pick(s: \"$abs_stop\",  d: \"2026-09-28T20:35:00+09:00\"))\r\nwin       = duration(v: pick(s: \"$window\", d: \"1m\"))\r\n\r\nstart = if mode == \"relative\" then date.add(d: rel, to: now())\r\n  else if mode == \"absolute\" or mode == \"window\" then abs_start\r\n  else date.time(t: v.timeRangeStart)\r\nstop = if mode == \"relative\" then now()\r\n  else if mode == \"absolute\" then abs_stop\r\n  else if mode == \"window\" then date.add(d: win, to: abs_start)\r\n  else date.time(t: v.timeRangeStop)\r\n\r\n// ---- ここから下をパネルごとに書き換える ----\r\nfrom(bucket: \"rocket_payload\")\r\n  |> range(start: start, stop: stop)\r\n  |> filter(fn: (r) => r._measurement == \"rocket_telemetry\")\r\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"topic\"])\r\n  |> group()\r\n  |> sort(columns: [\"_time\"], desc: true)\r\n",
          "refId": "A"
